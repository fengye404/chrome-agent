{
  "manifest_version": 3,
  "name": "Chrome Agent",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Let a local agent assist with a selected video submission tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "nativeMessaging",
    "debugger"
  ],
  "action": {
    "default_title": "Chrome Agent \u00b7 \u70b9\u51fb\u8fde\u63a5\u6216\u65ad\u5f00"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
